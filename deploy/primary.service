[Unit]
Description=Primary — Deterministic Telegraph Protocol Miner (SSL & URL Verifier)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/primary
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
EnvironmentFile=-/opt/primary/.env
ExecStart=/usr/bin/npx tsx /opt/primary/src/server.ts
Restart=always
RestartSec=2
StartLimitIntervalSec=60
StartLimitBurst=10
NoNewPrivileges=true
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=primary-miner

[Install]
WantedBy=multi-user.target
